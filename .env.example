# Copy to .env and fill in. Every value in config/relay.yaml written as ${VAR:-default}
# has a dev default, so the service starts without any of these for a local demo.

# --- Relay process ---------------------------------------------------------------
RELAY_ENV=dev                       # dev | test | prod (prod requires RELAY_ADMIN_TOKEN and real source secrets)
RELAY_ADMIN_TOKEN=change-me         # Bearer token for /admin/api and the dashboard
RELAY_QUEUE_BACKEND=memory          # memory | redis
RELAY_REDIS_URL=redis://localhost:6379/0
RELAY_STORE_BACKEND=sqlite          # sqlite | memory
RELAY_SQLITE_PATH=data/relay.db
RELAY_MAX_ATTEMPTS=8
RELAY_BACKOFF_BASE_SECONDS=2
RELAY_STOCK_CORS_ORIGINS=https://shop.example.com
RELAY_LOG_JSON=true

# --- Inbound sources -------------------------------------------------------------
TILDA_API_KEY=
AMOCRM_WEBHOOK_TOKEN=
BITRIX_APP_TOKEN=
BITRIX_REST_WEBHOOK_URL=            # optional: https://<portal>.bitrix24.ru/rest/1/<code>/
PARTNER_HMAC_SECRET=

# --- Destinations ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=        # the whole JSON key in one line (or use GOOGLE_ACCESS_TOKEN)
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_EMAIL_TO=
WAREHOUSE_WEBHOOK_URL=
WAREHOUSE_WEBHOOK_SECRET=

# --- MoySklad stock proxy --------------------------------------------------------
MOYSKLAD_TOKEN=
